# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
.env

# OS / IDE
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Raw/intermediate data - keep data local, not in Git
data/raw/*.csv
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained artifacts
models/*
!models/.gitkeep

# Generated outputs
reports/figures/*
reports/metrics/*.json
reports/predictions/*
!reports/figures/.gitkeep
!reports/predictions/.gitkeep

# Streamlit
.streamlit/secrets.toml

# Editable-install package metadata
*.egg-info/
